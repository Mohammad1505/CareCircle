SECRET_KEY=change-me
# Gemini (optional, enables natural-language medicine entry; a simple fallback parser is used without it)
GEMINI_API_KEY=
# SMTP (optional; without it emails are only written to the in-app notification log and the console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-app-password
# Minutes after a dose is due before the caretaker is alerted (family is alerted at twice this)
ESCALATE_MIN=30
